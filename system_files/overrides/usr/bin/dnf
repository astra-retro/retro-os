#!/usr/bin/bash

# Redirect to dnf5 if we are running inside a container or usroverlay is enabled
if systemd-detect-virt -cq || { [[ -e /run/.containerenv || -e /.dockerenv ]]; } || { [[ $(rpm-ostree status --json --booted | jq -r '.deployments[0]["unlocked"]') == 'development' ]] }; then
    exec /usr/bin/dnf5 "$@"
fi

# Show the error if we attempt to use the install/uninstall commands
for arg in "$@"; do
    if [[ $arg == "install" || $arg == "in" || $arg == "remove" || $arg == "rm" ]]; then
        echo -e "ERROR: Fedora Atomic images utilize rpm-ostree instead (and is discouraged to use).\n" >&2
        exit 1
    fi
done

# Fallback to dnf5
exec /usr/bin/dnf5 "$@"
