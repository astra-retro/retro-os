# First-boot GNOME Initial Setup runs in a special GDM session before
# the desktop user exists. This is separate from dconf's local user profile.
# Keep both light/dark URIs aligned with the already installed desktop image.
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/astra-retro-os/wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/astra-retro-os/wallpaper.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/astra-retro-os/wallpaper.png'
picture-options='zoom'

# GNOME's login-screen.logo is a foreground greeter badge, NOT a
# wallpaper. The large 512px Astra application icon hid the login prompt.
# Explicitly clear it so updates to already installed systems revert the
# previously generated GDM dconf value instead of leaving a stale logo.
[org/gnome/login-screen]
logo=''
