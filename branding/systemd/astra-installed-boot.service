[Unit]
Description=Synchronize Astra Retro OS installed boot graphics and debug entry
After=local-fs.target
RequiresMountsFor=/boot
ConditionPathExists=/boot/grub2/grub.cfg

[Service]
# Fedora bootc often presents /boot read-only. Allow the sync script to
# remount it temporarily without changing the host mount namespace.
PrivateMounts=yes
Type=oneshot
ExecStart=/usr/libexec/astra-retro-os/sync-installed-boot

[Install]
WantedBy=multi-user.target
