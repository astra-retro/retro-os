# Astra Retro OS - Plymouth splash with animated neon spinner.
# Background remains unchanged. A 96x96 cyan/magenta ring spins below center.
background_image = Image("plymouth-splash.png");
background_sprite = Sprite(background_image);
background_sprite.SetZ(-100);

# Separate transparent title, layered above the logo embedded in the backdrop.
title_image = Image("astra-title.png");
title_sprite = Sprite(title_image);
title_sprite.SetZ(20);

spinner_image = Image("spinner.png");
spinner_frame_image = spinner_image;
spinner_sprite = Sprite(spinner_frame_image);
spinner_sprite.SetZ(100);

spinner_tick = 0;
spinner_frame = 0;

fun refresh_callback () {
  # Recenter on display changes.
  background_sprite.SetX((Window.GetWidth() - background_image.GetWidth()) / 2);
  background_sprite.SetY((Window.GetHeight() - background_image.GetHeight()) / 2);

  # Anchor the title to the backdrop (which already contains the Astra logo).
  # At 1920x1080 it sits around y=270, safely above the centered logo.
  title_sprite.SetX((Window.GetWidth() - title_image.GetWidth()) / 2);
  title_sprite.SetY((Window.GetHeight() - background_image.GetHeight()) / 2 + background_image.GetHeight() * 0.25);

  # Refresh happens repeatedly; rotate one step every third callback.
  # This is an indeterminate indicator, not an estimate of boot progress.
  spinner_tick = spinner_tick + 1;
  if (spinner_tick >= 3) {
    spinner_tick = 0;
    spinner_frame = (spinner_frame + 1) % 24;
    spinner_frame_image = spinner_image.Rotate((2 * Math.Pi * spinner_frame) / 24);
    spinner_sprite.SetImage(spinner_frame_image);
  }

  spinner_sprite.SetX((Window.GetWidth() - spinner_frame_image.GetWidth()) / 2);
  spinner_sprite.SetY(Window.GetHeight() * 0.74 - spinner_frame_image.GetHeight() / 2);
}

Plymouth.SetRefreshFunction(refresh_callback);
